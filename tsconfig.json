{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*",
    "astro.config.mjs",
    "eslint.config.js",
    "playwright.config.ts",
    "prettier.config.mjs"
  ],
  "exclude": ["dist", "node_modules", "playwright-report", "test-results"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
