---
import DateRange from '../ui/DateRange.astro';
import type { PortfolioSectionProps } from './types';

type Props = PortfolioSectionProps;

const { section, site } = Astro.props;
---

<section id={section.id} class="evidence__section" aria-labelledby={`${section.id}-title`}>
  <h2 id={`${section.id}-title`}>{section.label}</h2>

  <div class="about-copy">
    {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="profile-details">
    <div class="education-block">
      <h3>Education</h3>
      {
        site.education.map((entry) => (
          <article class="education-entry">
            <h4>{entry.institution}</h4>
            <p>{entry.degree}</p>
            <p class="education-entry__meta">
              <span>{entry.location}</span>
              <span aria-hidden="true">·</span>
              <DateRange start={entry.start} end={entry.end} />
            </p>
          </article>
        ))
      }
    </div>

    <div class="skills-block">
      <h3>Selected skills</h3>
      <dl class="skill-groups">
        {
          site.skillGroups.map((group) => (
            <div class="skill-group">
              <dt>{group.label}</dt>
              <dd>{group.skills.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
