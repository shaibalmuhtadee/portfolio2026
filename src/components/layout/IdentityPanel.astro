---
import { ArrowRight, BriefcaseBusiness, MapPin } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import type { SimpleIcon } from 'simple-icons';

const siLinkedin: SimpleIcon = {
  slug: "linkedin",
  path: "M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z",
  svg: '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"/></svg>',
  title: "LinkedIn",
  hex: "0A66C2",
  source: "iconify",
};

import type { SiteConfig } from '../../data/site';
import BrandIcon from '../ui/BrandIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  site: SiteConfig;
  resumeHref?: string | undefined;
}

const { site, resumeHref } = Astro.props;
---

<header class="identity">
  <strong class="identity__name">{site.name}</strong>
  <p class="identity__role">{site.role}</p>
  <h1>{site.headline}</h1>
  <!-- <p class="identity__intro">{site.supportingCopy}</p> -->

  {
    resumeHref && (
      <a class="primary-action" href={resumeHref}>
        <span>View resume</span>
        <ArrowRight aria-hidden="true" size={20} stroke-width={2.2} />
      </a>
    )
  }

  <!-- TODO: navigation UI -->
  <nav>
    <a href="#about">About</a>
    <a href="#experience">Experience</a>
    <a href="#projects">Projects</a>
    <a href="#skills">Skills</a>
    <a href="#contact">Contact</a>
  </nav>

  <ul class="identity__facts" aria-label="Location and availability">
    <li>
      <MapPin aria-hidden="true" size={21} stroke-width={2} />
      <span>{site.location}</span>
    </li>
    <li>
      <BriefcaseBusiness aria-hidden="true" size={21} stroke-width={2} />
      <span>{site.eligibilitySummary}</span>
    </li>
  </ul>

  <nav class="identity__social" aria-label="Professional profiles">
    <ThemeToggle />
    <a href={site.social.linkedin}>
      <BrandIcon icon={siLinkedin} size={27} />
      <span>LinkedIn</span>
    </a>
    <a href={site.social.github}>
      <BrandIcon icon={siGithub} size={23} />
      <span>GitHub</span>
    </a>
  </nav>
</header>
