---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  decorative?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [480, 768, 1024, 1440],
  priority = false,
  decorative = false,
  class: className,
} = Astro.props;
const resolvedAlt = decorative ? '' : alt.trim();

if (!decorative && !resolvedAlt) {
  throw new Error('ResponsiveImage requires useful alt text unless it is explicitly decorative.');
}
---

<Picture
  src={src}
  alt={resolvedAlt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  priority={priority}
  class={className}
/>
