---
import IdentityPanel from '../components/layout/IdentityPanel.astro';
import { sectionRegistry } from '../components/sections/registry';
import { sections } from '../data/sections';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPortfolioContent } from '../lib/content';
import '../styles/home.css';

const content = await getPortfolioContent();
const enabledSections = sections.filter(({ enabled }) => enabled);
const experienceSection = enabledSections.find(({ id }) => id === 'experience');
---

<BaseLayout canonicalPath="/">
  <div class="portfolio">
    <IdentityPanel site={site} experienceHref={experienceSection ? '#experience' : undefined} />

    <main id="main-content" class="evidence">
      {
        enabledSections.map((section) => {
          const SectionComponent = sectionRegistry[section.id];
          return <SectionComponent section={section} content={content} site={site} />;
        })
      }
    </main>
  </div>
</BaseLayout>
