{
  "name": "shaibal-muhtadee-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "astro sync",
    "precheck": "astro sync",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "prebuild": "pnpm validate:content",
    "build": "astro build",
    "postbuild": "pnpm generate:sitemap && pnpm verify:build",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "precompress:dist": "node scripts/precompress-dist.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm build && playwright test",
    "test:release": "pnpm build && pnpm check:links && playwright test && pnpm test:lighthouse",
    "quality": "pnpm format:check && pnpm lint && pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@lucide/astro": "1.28.0",
    "astro": "7.1.6",
    "simple-icons": "16.28.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.9.0",
    "gray-matter": "4.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "workspaces": [
    "."
  ]
}
